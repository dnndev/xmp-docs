<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- These are static VitePress folders; index.html is the only default
         document they need. <clear/> drops whatever the parent DNN web.config
         inherited (DNN typically clears the list down to Default.aspx, which
         leaves a directory request like /v5/ with no document to serve -> 403).
         Clearing first also avoids a duplicate-entry 500.19 if index.html were
         already inherited. -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <!-- IMPORTANT: both rules match on {REQUEST_URI} (the ABSOLUTE path),
             NOT on the folder-relative match url. Folder-relative matching is
             fragile: if this web.config is inherited by the v4//v5/ subfolders
             (or accidentally lands inside one), a relative "^$" rule fires on
             the /v5/ directory request and redirects /v5/ -> /v5/ forever.
             Anchoring on {REQUEST_URI} makes the rules immune to placement and
             inheritance, and the negative lookahead guarantees a request already
             under /v4/ or /v5/ is never redirected -> no loops.

             redirectType is Found (302) during rollout so a mistaken redirect
             is never cached by browsers/CDNs. Promote to Permanent (301) only
             after the URLs are verified stable. -->
        <!-- Rule A: bare /help/xmodpro root -> latest (v5) -->
        <rule name="XmpHelpRootToLatest" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/help/xmodpro/?$" />
          </conditions>
          <action type="Redirect" url="/help/xmodpro/v5/" redirectType="Found" />
        </rule>
        <!-- Rule B: legacy deep links (anything under /help/xmodpro/ not already
             in a version folder) -> v5 equivalent. -->
        <rule name="XmpHelpLegacyDeepLinks" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/help/xmodpro/(?!v4/|v5/)(.+)$" />
          </conditions>
          <action type="Redirect" url="/help/xmodpro/v5/{C:1}" redirectType="Found" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
