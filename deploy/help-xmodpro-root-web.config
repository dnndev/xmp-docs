<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Rule A: bare /help/xmodpro/ root -> latest (v5) -->
        <rule name="XmpHelpRootToLatest" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/help/xmodpro/v5/" redirectType="Permanent" />
        </rule>
        <!-- Rule B: legacy deep links (anything not already under v4/ or v5/) -> v5 equivalent.
             Negative lookahead excludes v4/ and v5/ so versioned paths and the redirect
             target never match (prevents loops). -->
        <rule name="XmpHelpLegacyDeepLinks" stopProcessing="true">
          <match url="^(?!v4/|v5/)(.+)$" />
          <action type="Redirect" url="/help/xmodpro/v5/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
